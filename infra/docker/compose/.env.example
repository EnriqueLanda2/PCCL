# Copia este archivo a ".env" en esta misma carpeta (infra/docker/compose/.env)
# — docker compose lo carga solo. Rellena lo obligatorio; el resto son
# integraciones opcionales (podés dejarlas vacías y la app sigue funcionando,
# solo que sin esa feature puntual).

# ── Dominio + HTTPS (obligatorio para producción) ─────────────────────────────
# Un dominio/subdominio real apuntando (registro A) a la IP pública/elástica
# de tu instancia EC2. Caddy pide el certificado TLS solo con esto.
DOMAIN=tu-dominio.com
FRONTEND_URL=https://tu-dominio.com
COOKIE_DOMAIN=tu-dominio.com
NEXT_PUBLIC_API_URL=https://tu-dominio.com/api
NODE_ENV=production

# ── Seguridad (obligatorio) ────────────────────────────────────────────────────
# Genera uno con: openssl rand -base64 48
JWT_SECRET=

# ── Cloudinary (obligatorio para portadas/documentos/videos/certificados) ─────
# Cuenta gratis en https://cloudinary.com → Dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Stripe modo test (opcional — sin esto, la compra de cursos de pago falla) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── JaaS / 8x8.vc (opcional — moderador de las clases en vivo) ────────────────
JAAS_APP_ID=
JAAS_API_KEY_ID=
JAAS_PRIVATE_KEY=

# ── Firebase Admin (opcional — notificaciones push) ────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Ollama / AIRumbo (opcional — ver nota abajo) ───────────────────────────────
# Un t3.small/t3.medium no tiene RAM/CPU para correr un modelo local: dejalo
# vacío (el chatbot simplemente no responde) o apuntá a un Ollama que corras
# en tu propia máquina y expongas con un túnel (ver apps/backend/.env.example).
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASIC_AUTH_USERNAME=
OLLAMA_BASIC_AUTH_PASSWORD=
