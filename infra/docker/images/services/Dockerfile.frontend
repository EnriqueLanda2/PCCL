FROM node:20-alpine AS builder
WORKDIR /app
COPY apps/frontend/web-shell/package.json ./
RUN npm install --no-audit --no-fund
COPY apps/frontend/web-shell ./
# NEXT_PUBLIC_* vars are inlined into the client bundle at build time, so this
# has to be a build ARG (not a runtime environment var like the other services).
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN npm run build

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3002
COPY --from=builder /app ./
EXPOSE 3002
CMD ["npm", "run", "start"]
