FROM node:22-alpine AS builder
WORKDIR /app

ARG NEXT_PUBLIC_API_URL=http://localhost:3010
ARG NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si
ARG NEXT_PUBLIC_RPM_SUBDOMAIN=disabled
ARG NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=disabled

ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_JITSI_DOMAIN=${NEXT_PUBLIC_JITSI_DOMAIN}
ENV NEXT_PUBLIC_RPM_SUBDOMAIN=${NEXT_PUBLIC_RPM_SUBDOMAIN}
ENV NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=${NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY}

RUN corepack enable && corepack prepare pnpm@11.8.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc .nvmrc tsconfig.base.json ./
COPY apps/frontend/web-shell ./apps/frontend/web-shell
COPY packages ./packages
COPY tools/avatar-pipeline ./tools/avatar-pipeline

RUN pnpm install --frozen-lockfile
RUN pnpm --filter frontend build

FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN corepack enable && corepack prepare pnpm@11.8.0 --activate

COPY --from=builder /app/package.json ./
COPY --from=builder /app/pnpm-lock.yaml ./
COPY --from=builder /app/pnpm-workspace.yaml ./
COPY --from=builder /app/.npmrc ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/frontend/web-shell ./apps/frontend/web-shell
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/tools/avatar-pipeline ./tools/avatar-pipeline

EXPOSE 3002

CMD ["pnpm", "--dir", "apps/frontend/web-shell", "start"]
