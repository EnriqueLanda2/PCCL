# ── API ──────────────────────────────────────────────────────────────────────
# URL del gateway del backend (ver PORT en apps/backend/.env).
NEXT_PUBLIC_API_URL=http://localhost:3010

# ── Jitsi (clases en vivo) ──────────────────────────────────────────────────
NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si

# ── Ready Player Me (avatares) ──────────────────────────────────────────────
NEXT_PUBLIC_RPM_SUBDOMAIN=

# ── Stripe (modo test) ───────────────────────────────────────────────────────
# Clave PUBLICABLE (no la secreta) — https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Firebase (notificaciones push) ────────────────────────────────────────────
# Del mismo proyecto Firebase que apps/backend/.env (FIREBASE_PROJECT_ID etc).
# Sacá estos valores de https://console.firebase.google.com → tu proyecto →
# ⚙️ Configuración del proyecto → General → "Tus apps" → app web (creala si no
# existe). NEXT_PUBLIC_FIREBASE_VAPID_KEY sale de la pestaña "Cloud Messaging"
# de esa misma pantalla, sección "Certificados push web" → "Generar par de claves".
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
