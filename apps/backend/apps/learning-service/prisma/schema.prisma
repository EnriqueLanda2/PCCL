generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("LEARNING_DATABASE_URL")
}

model Course {
  id              String       @id @default(uuid()) @db.Uuid
  transactionDate DateTime     @default(now()) @map("transaction_date") @db.Timestamp(6)
  startDate       DateTime?    @map("start_date") @db.Timestamp(6)
  endDate         DateTime?    @map("end_date") @db.Timestamp(6)
  createdBy       String?      @map("created_by") @db.VarChar(100)
  updatedBy       String?      @map("updated_by") @db.VarChar(100)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamp(6)
  title           String       @db.VarChar(140)
  description     String       @db.Text
  /** draft | pending_review | published | rejected */
  status          String       @default("draft") @db.VarChar(20)
  /** Motivo del revisor. Solo tiene sentido en 'rejected', pero no se limpia
      al reenviar a revisión hasta que haya una decisión nueva — así el
      instructor sigue viendo por qué se rechazó la última vez mientras
      corrige, en vez de que el campo desaparezca apenas reenvía. */
  moderationNote  String?      @map("moderation_note") @db.Text
  moderatedBy     String?      @map("moderated_by") @db.VarChar(100)
  moderatedAt     DateTime?    @map("moderated_at") @db.Timestamp(6)
  level           String       @default("basic") @db.VarChar(40)
  coverImageUrl   String?      @map("cover_image_url") @db.Text
  durationMinutes Int?         @map("duration_minutes")
  price           Decimal      @default(0) @db.Decimal(10, 2)
  currency        String       @default("USD") @db.VarChar(3)
  isFree          Boolean      @default(false) @map("is_free")
  lessons         Lesson[]
  phases          Phase[]
  inscriptions    Inscription[]
  evaluations     Evaluation[]
  liveSessions    LiveSession[]
  comments        CourseComment[]
  reviews         CourseReview[]
  favorites       CourseFavorite[]

  @@map("courses")
}

/// Fase/módulo del curso — agrupa lecciones en pasos secuenciales (ej. "Fase
/// 1: Fundamentos"). `order` determina la secuencia; una clase en vivo o una
/// lección puede pertenecer a una fase para que el alumno sepa dónde encaja
/// dentro del camino del curso.
model Phase {
  id              String        @id @default(uuid()) @db.Uuid
  transactionDate DateTime      @default(now()) @map("transaction_date") @db.Timestamp(6)
  createdBy       String?       @map("created_by") @db.VarChar(100)
  updatedBy       String?       @map("updated_by") @db.VarChar(100)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamp(6)
  title           String        @db.VarChar(140)
  order           Int
  courseId        String        @map("course_id") @db.Uuid
  course          Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons         Lesson[]
  liveSessions    LiveSession[]
  evaluations     Evaluation[]

  @@index([courseId])
  @@map("phases")
}

/// Reseña real de un alumno sobre un curso. Una reseña por alumno/curso.
/// userId apunta a identity-service, por eso se guarda sin relación SQL.
model CourseReview {
  id              String   @id @default(uuid()) @db.Uuid
  transactionDate DateTime @default(now()) @map("transaction_date") @db.Timestamp(6)
  createdBy       String?  @map("created_by") @db.VarChar(100)
  updatedBy       String?  @map("updated_by") @db.VarChar(100)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  courseId        String   @map("course_id") @db.Uuid
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId          String   @map("user_id") @db.Uuid
  rating          Int
  comment         String?  @db.Text

  @@unique([courseId, userId])
  @@index([courseId])
  @@index([userId])
  @@map("course_reviews")
}

/// Comentario público de un alumno en un curso. userId apunta a
/// identity-service (otra base), por eso no hay relación real; el nombre a
/// mostrar se resuelve al leer, como en Inscription.
model CourseComment {
  id              String   @id @default(uuid()) @db.Uuid
  transactionDate DateTime @default(now()) @map("transaction_date") @db.Timestamp(6)
  createdBy       String?  @map("created_by") @db.VarChar(100)
  updatedBy       String?  @map("updated_by") @db.VarChar(100)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  courseId        String   @map("course_id") @db.Uuid
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId          String   @map("user_id") @db.Uuid
  content         String   @db.Text
  /// Ids de usuarios que dieron "me gusta" — evita una tabla extra para algo
  /// que solo se lee agregado.
  likedBy         String[] @default([]) @map("liked_by") @db.Uuid

  @@index([courseId])
  @@map("course_comments")
}

model Lesson {
  id              String         @id @default(uuid()) @db.Uuid
  transactionDate DateTime       @default(now()) @map("transaction_date") @db.Timestamp(6)
  startDate       DateTime?      @map("start_date") @db.Timestamp(6)
  endDate         DateTime?      @map("end_date") @db.Timestamp(6)
  createdBy       String?        @map("created_by") @db.VarChar(100)
  updatedBy       String?        @map("updated_by") @db.VarChar(100)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamp(6)
  title           String         @db.VarChar(140)
  content         String         @db.Text
  contentType     String         @default("text") @map("content_type") @db.VarChar(20)
  /** URL de Cloudinary del adjunto (video o documento) cuando contentType es 'video' o 'file' */
  fileUrl         String?        @map("file_url") @db.Text
  durationMinutes Int?           @map("duration_minutes")
  courseId        String         @map("course_id") @db.Uuid
  course          Course         @relation(fields: [courseId], references: [id])
  phaseId         String?        @map("phase_id") @db.Uuid
  phase           Phase?         @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  califications   Calification[]
  notes           Note[]
  completions     LessonCompletion[]
  chatMessages    ChatMessage[]
  submissions     AssignmentSubmission[]

  @@map("lessons")
}

/// Entrega de una tarea (lección con contentType 'assignment'): el alumno sube
/// un archivo y el instructor la califica a mano con puntaje y retroalimentación.
/// Una entrega por alumno/lección; re-entregar reemplaza el archivo y borra la
/// calificación anterior (el instructor vuelve a calificar lo nuevo).
/// userId apunta a identity-service (otra base) — sin relación SQL, igual que
/// en Inscription; userEmail se guarda para que el instructor vea quién entregó
/// sin cruzar bases.
model AssignmentSubmission {
  id          String    @id @default(uuid()) @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  lessonId    String    @map("lesson_id") @db.Uuid
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id") @db.Uuid
  userEmail   String?   @map("user_email") @db.VarChar(100)
  fileUrl     String    @map("file_url") @db.Text
  fileName    String?   @map("file_name") @db.VarChar(200)
  comment     String?   @db.Text
  submittedAt DateTime  @default(now()) @map("submitted_at") @db.Timestamp(6)
  /// null = sin calificar todavía; 0–100
  score       Int?
  feedback    String?   @db.Text
  gradedBy    String?   @map("graded_by") @db.VarChar(100)
  gradedAt    DateTime? @map("graded_at") @db.Timestamp(6)

  @@unique([lessonId, userId])
  @@index([lessonId])
  @@map("assignment_submissions")
}

/// Mensaje del chatbot "AIRumbo" (IA local vía Ollama). userId apunta a
/// identity-service, por eso se guarda sin relación SQL, igual que en
/// Inscription. conversationId agrupa el hilo (varias conversaciones pueden
/// compartir el mismo lessonId, o ninguno — chat general). lessonId nulo =
/// conversación sin contexto de curso.
model ChatMessage {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  lessonId       String?  @map("lesson_id") @db.Uuid
  lesson         Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  role           String   @db.VarChar(20)
  content        String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([userId, conversationId])
  @@map("chat_messages")
}

/// Marca de "lección vista" por alumno. Sin esta tabla no existía forma de
/// saber qué le falta a cada quien: Progress solo guarda un contador agregado.
/// userId apunta a identity-service (otra base), por eso no hay relación real.
model LessonCompletion {
  id              String   @id @default(uuid()) @db.Uuid
  transactionDate DateTime @default(now()) @map("transaction_date") @db.Timestamp(6)
  createdBy       String?  @map("created_by") @db.VarChar(100)
  updatedBy       String?  @map("updated_by") @db.VarChar(100)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  userId          String   @map("user_id") @db.Uuid
  lessonId        String   @map("lesson_id") @db.Uuid
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt     DateTime @default(now()) @map("completed_at") @db.Timestamp(6)

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("lesson_completions")
}

/** "Guardado" del alumno en la ficha de curso — un bookmark simple, no
    implica inscripción ni progreso, solo lo enlaza a su lista de guardados. */
model CourseFavorite {
  id              String   @id @default(uuid()) @db.Uuid
  transactionDate DateTime @default(now()) @map("transaction_date") @db.Timestamp(6)
  createdBy       String?  @map("created_by") @db.VarChar(100)
  updatedBy       String?  @map("updated_by") @db.VarChar(100)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  userId          String   @map("user_id") @db.Uuid
  courseId        String   @map("course_id") @db.Uuid
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@map("course_favorites")
}

model Inscription {
  id                 String     @id @default(uuid()) @db.Uuid
  transactionDate    DateTime   @default(now()) @map("transaction_date") @db.Timestamp(6)
  startDate          DateTime?  @map("start_date") @db.Timestamp(6)
  endDate            DateTime?  @map("end_date") @db.Timestamp(6)
  createdBy          String?    @map("created_by") @db.VarChar(100)
  updatedBy          String?    @map("updated_by") @db.VarChar(100)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamp(6)
  userId             String     @map("user_id") @db.Uuid
  courseId           String     @map("course_id") @db.Uuid
  course             Course     @relation(fields: [courseId], references: [id])
  status             String     @default("enrolled") @db.VarChar(20)
  progressPercentage Decimal?   @map("progress_percentage") @db.Decimal(5, 2)
  completedAt        DateTime?  @map("completed_at") @db.Timestamp(6)
  progress           Progress[]

  @@map("inscriptions")
}

model Progress {
  id                   String      @id @default(uuid()) @db.Uuid
  transactionDate      DateTime    @default(now()) @map("transaction_date") @db.Timestamp(6)
  startDate            DateTime?   @map("start_date") @db.Timestamp(6)
  endDate              DateTime?   @map("end_date") @db.Timestamp(6)
  createdBy            String?     @map("created_by") @db.VarChar(100)
  updatedBy            String?     @map("updated_by") @db.VarChar(100)
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamp(6)
  inscriptionId        String      @map("inscription_id") @db.Uuid
  inscription          Inscription @relation(fields: [inscriptionId], references: [id])
  lessonsCompleted     Decimal     @default(0) @map("lessons_completed") @db.Decimal(5, 2)
  evaluationsCompleted Decimal     @default(0) @map("evaluations_completed") @db.Decimal(5, 2)
  averageScore         Decimal     @default(0) @map("average_score") @db.Decimal(5, 2)
  progressPercentage   Decimal     @default(0) @map("progress_percentage") @db.Decimal(5, 2)
  lastAccessAt         DateTime?   @map("last_access_at") @db.Timestamp(6)

  @@map("progress")
}

model Calification {
  id              String    @id @default(uuid()) @db.Uuid
  transactionDate DateTime  @default(now()) @map("transaction_date") @db.Timestamp(6)
  startDate       DateTime? @map("start_date") @db.Timestamp(6)
  endDate         DateTime? @map("end_date") @db.Timestamp(6)
  createdBy       String?   @map("created_by") @db.VarChar(100)
  updatedBy       String?   @map("updated_by") @db.VarChar(100)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  title           String    @db.VarChar(140)
  content         String    @db.Text
  type            String    @default("quiz") @db.VarChar(20)
  totalPoints     Int       @default(10) @map("total_points")
  maxAttempts     Int       @default(1) @map("max_attempts")
  lessonId        String    @map("lesson_id") @db.Uuid
  lesson          Lesson    @relation(fields: [lessonId], references: [id])

  @@map("califications")
}

model Note {
  id              String   @id @default(uuid()) @db.Uuid
  transactionDate DateTime @default(now()) @map("transaction_date") @db.Timestamp(6)
  createdBy       String?  @map("created_by") @db.VarChar(100)
  updatedBy       String?  @map("updated_by") @db.VarChar(100)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  /** Contenido enriquecido serializado (JSON de TipTap, stringify) con soporte LaTeX */
  content         String   @db.Text
  lessonId        String   @map("lesson_id") @db.Uuid
  lesson          Lesson   @relation(fields: [lessonId], references: [id])

  @@map("notes")
}

model Evaluation {
  id              String              @id @default(uuid()) @db.Uuid
  transactionDate DateTime            @default(now()) @map("transaction_date") @db.Timestamp(6)
  startDate       DateTime?           @map("start_date") @db.Timestamp(6)
  endDate         DateTime?           @map("end_date") @db.Timestamp(6)
  createdBy       String?             @map("created_by") @db.VarChar(100)
  updatedBy       String?             @map("updated_by") @db.VarChar(100)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamp(6)
  title           String              @db.VarChar(140)
  description     String?             @db.Text
  topic           String?             @db.VarChar(120)
  kind            String              @default("kahoot") @db.VarChar(20)
  passingScore    Int                 @default(70) @map("passing_score")
  questions       Json?
  courseId        String              @map("course_id") @db.Uuid
  course          Course              @relation(fields: [courseId], references: [id])
  phaseId         String?             @map("phase_id") @db.Uuid
  phase           Phase?              @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  /// Dónde cae este examen dentro de la fase: antes de sus lecciones ('start')
  /// o después de completarlas todas ('end', el default — un examen final
  /// de fase).
  phasePosition   String              @default("end") @map("phase_position") @db.VarChar(10)
  attempts        EvaluationAttempt[]

  @@map("evaluations")
}

model LiveSession {
  id              String   @id @default(uuid()) @db.Uuid
  transactionDate DateTime @default(now()) @map("transaction_date") @db.Timestamp(6)
  createdBy       String?  @map("created_by") @db.VarChar(100)
  updatedBy       String?  @map("updated_by") @db.VarChar(100)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  title           String   @db.VarChar(140)
  hostName        String   @map("host_name") @db.VarChar(120)
  scheduledAt     DateTime @map("scheduled_at") @db.Timestamp(6)
  durationMinutes Int      @default(60) @map("duration_minutes")
  joinUrl         String?  @map("join_url") @db.Text
  status          String   @default("scheduled") @db.VarChar(20) // scheduled | live | ended | canceled
  courseId        String?  @map("course_id") @db.Uuid
  course          Course?  @relation(fields: [courseId], references: [id])
  phaseId         String?  @map("phase_id") @db.Uuid
  phase           Phase?   @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  @@map("live_sessions")
}

/// Resultado real de una trivia de estudio generada por AIRumbo y contestada
/// por voz desde la skill de Alexa. Es la fuente de verdad tanto para lo que
/// Alexa dice en "cómo voy en mis estudios" como para cualquier vista futura
/// en la web: no se inventa ni se cachea en Alexa, se calcula desde aquí.
/// userId apunta a identity-service, igual que en Inscription/ChatMessage,
/// por eso no hay relación SQL. alexaUserId es el id crudo que manda Alexa,
/// se guarda solo como bitácora de qué dispositivo/cuenta de Alexa disparó
/// el resultado.
model AlexaTriviaResult {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  userId      String   @map("user_id") @db.Uuid
  alexaUserId String   @map("alexa_user_id") @db.VarChar(200)
  courseId    String?  @map("course_id") @db.Uuid
  topic       String   @db.VarChar(140)
  total       Int
  correct     Int
  score       Int
  answers     Json

  @@index([userId])
  @@map("alexa_trivia_results")
}

model EvaluationAttempt {
  id              String     @id @default(uuid()) @db.Uuid
  transactionDate DateTime   @default(now()) @map("transaction_date") @db.Timestamp(6)
  startDate       DateTime?  @map("start_date") @db.Timestamp(6)
  endDate         DateTime?  @map("end_date") @db.Timestamp(6)
  createdBy       String?    @map("created_by") @db.VarChar(100)
  updatedBy       String?    @map("updated_by") @db.VarChar(100)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamp(6)
  evaluationId    String     @map("evaluation_id") @db.Uuid
  evaluation      Evaluation @relation(fields: [evaluationId], references: [id])
  studentId       String     @map("student_id") @db.Uuid
  answers         Json
  score           Decimal?   @map("score") @db.Decimal(5, 2)

  @@map("evaluation_attempts")
}
