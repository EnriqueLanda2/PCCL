# ── Gateway ──────────────────────────────────────────────────────────────────
PORT=3010
FRONTEND_URL=http://localhost:3002
COOKIE_DOMAIN=localhost
NODE_ENV=development

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=pccl_secret_change_in_prod
JWT_EXPIRES_IN=1d

# ── Correo (Resend) ─────────────────────────────────────────────────────────
# Sin RESEND_API_KEY, el código de recuperación se loggea a consola en vez de
# mandarse por correo — útil para probar el flujo en local.
RESEND_API_KEY=
MAIL_FROM=no-reply@koodisoft.com

# ── NATS ─────────────────────────────────────────────────────────────────────
NATS_URL=nats://localhost:4222

# ── Databases (one per service) ───────────────────────────────────────────────
IDENTITY_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/identity
LEARNING_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/learning
CERTIFICATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5435/certification
PAYMENT_DATABASE_URL=postgresql://postgres:postgres@localhost:5436/payment
# docker run -d -p 5436:5432 -e POSTGRES_DB=payment -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=root postgres:15-alpine

# ── Stripe (modo test) ─────────────────────────────────────────────────────────
# Crea una cuenta gratis en https://stripe.com, activa el modo test y copia
# la clave secreta desde https://dashboard.stripe.com/test/apikeys.
# STRIPE_WEBHOOK_SECRET se obtiene corriendo localmente:
#   stripe listen --forward-to localhost:3010/payments/webhook/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Cloudinary (portadas, documentos y videos de lección —
#    POST /uploads/image | /uploads/document | /uploads/video) ────────────────
# Crea una cuenta gratis en https://cloudinary.com y copia estos 3 valores
# desde tu Dashboard. Sin ellos, la subida de archivos falla.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Rumbo (chatbot IA local vía Ollama) ────────────────────────────────────────
# Corre `ollama serve` en tu máquina y jala el modelo con `ollama pull llama3.1`.
# Si el frontend/backend corren en otra máquina, expón el puerto 11434 con un
# túnel y pon esa URL pública aquí. Con ngrok, Ollama recomienda:
#   ngrok http 11434 --host-header="localhost:11434" --traffic-policy-file ngrok-ollama-policy.yml
# Ejemplo:
#   OLLAMA_URL=https://tu-subdominio.ngrok.app
#   OLLAMA_BASIC_AUTH_USERNAME=rumbo
#   OLLAMA_BASIC_AUTH_PASSWORD=cambia-esta-clave
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASIC_AUTH_USERNAME=
OLLAMA_BASIC_AUTH_PASSWORD=

# ── JaaS / 8x8.vc (moderador de las clases en vivo por Jitsi) ─────────────────
# Sin esto, las clases siguen funcionando con el meet.jit.si público, pero
# cualquier participante ve el cuadro de Jitsi pidiendo "reclamar" el rol de
# moderador a mano. Con estas 3 variables, el backend firma el JWT y decide
# el moderador (quien creó la clase) sin que nadie tenga que elegir nada.
# Sacalas de https://jaas.8x8.vc → tu app → "API keys":
#  · JAAS_APP_ID: el App ID que te muestra el dashboard.
#  · JAAS_API_KEY_ID: el "kid" de la API key que generes ahí mismo.
#  · JAAS_PRIVATE_KEY: la clave privada (.pk) que te descargás al crear la
#    API key. Pegala en una sola línea, con los saltos de línea como "\n"
#    literales (así: "-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END...").
JAAS_APP_ID=
JAAS_API_KEY_ID=
JAAS_PRIVATE_KEY=

# ── Skill de Alexa (agenda, trivia con AIRumbo y progreso) ────────────────────
# La Lambda de la skill (docs/alexa/02-back-alexa-skill.md) llama a
# POST/GET /alexa/* del gateway con este header: x-alexa-api-key: <ALEXA_API_KEY>.
# Genera cualquier cadena larga y aleatoria — es lo único que impide que
# cualquiera en internet agende clases o gaste cuota de AIRumbo.
ALEXA_API_KEY=
# Cuenta real de PCCL (admin o instructor) bajo la que Alexa agenda las
# clases en vivo — así aparecen en "Clases en vivo" de esa cuenta en la web.
# ALEXA_LINKED_USER_EMAIL debe ser el email exacto de esa cuenta;
# ALEXA_LINKED_USER_ID es su id (columna "id" en la tabla users de identity).
ALEXA_LINKED_USER_EMAIL=
ALEXA_LINKED_USER_ID=

# ── Firebase Admin (notificaciones push) ──────────────────────────────────────
# Sin esto, las notificaciones push quedan deshabilitadas (no rompe nada, solo
# no se manda nada). Sacalas de https://console.firebase.google.com → tu
# proyecto → ⚙️ Configuración del proyecto → Cuentas de servicio → "Generar
# nueva clave privada" (descarga un JSON con estos 3 campos).
#  · FIREBASE_PROJECT_ID: el "project_id" del JSON.
#  · FIREBASE_CLIENT_EMAIL: el "client_email" del JSON.
#  · FIREBASE_PRIVATE_KEY: el "private_key" del JSON, en una sola línea, con
#    los saltos de línea como "\n" literales (mismo criterio que JAAS_PRIVATE_KEY).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
